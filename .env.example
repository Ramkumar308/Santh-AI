# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AGMARKNET_API_KEY: Data.gov.in Agmarknet API Key for live mandi commodity rates (server or edge)
AGMARKNET_API_KEY=""
VITE_AGMARKNET_API_KEY=""

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Supabase configuration for Google Auth, Stock, Khata & ResQ PostgreSQL
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
